# Monad testnet
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
MONAD_EXPLORER_URL=https://monadvision.com

# Deployer / relayer keys
# Never commit real private keys.
DEPLOYER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=

# Deployed contract addresses — populated automatically after running pnpm deploy:monad
SESSION_MANAGER_ADDRESS=
DEMO_GAME_ADDRESS=
DEMO_SOCIAL_ADDRESS=
GAME_TOKEN_ADDRESS=

# Relayer
RELAYER_PORT=3001
RELAYER_DATABASE_URL=file:./db/relayer.sqlite
RELAYER_CORS_ORIGIN=http://localhost:5173

# Frontend
VITE_CHAIN_ID=10143
VITE_RPC_URL=https://testnet-rpc.monad.xyz
VITE_MONAD_EXPLORER_URL=https://monadvision.com
