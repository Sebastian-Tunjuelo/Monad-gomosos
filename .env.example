VITE_RELAYER_URL=http://localhost:3001
VITE_SESSION_MANAGER_ADDRESS=
VITE_DEMO_GAME_ADDRESS=
VITE_DEMO_SOCIAL_ADDRESS=
VITE_GAME_TOKEN_ADDRESS=
