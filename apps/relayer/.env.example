# ── Monad Testnet ─────────────────────────────────────────────────────────────
# IMPORTANT: On Monad, gas is charged on gas_limit (not gas used).
#            The relayer uses tight gas estimates (+10% buffer) automatically.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
MONAD_EXPLORER_URL=https://monadvision.com
CHAIN_ID=10143

RELAYER_PRIVATE_KEY=
RELAYER_PORT=3001
RELAYER_DATABASE_URL=file:./db/relayer.sqlite
RELAYER_CORS_ORIGIN=http://localhost:5173

# Contract addresses — populated automatically after running pnpm deploy:monad
SESSION_MANAGER_ADDRESS=
DEMO_GAME_ADDRESS=
DEMO_SOCIAL_ADDRESS=
GAME_TOKEN_ADDRESS=

LOG_LEVEL=info
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
