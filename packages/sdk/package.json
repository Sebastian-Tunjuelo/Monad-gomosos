{
  "name": "@monad-session-arena/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript SDK for session keys in Monad Session Arena.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"No SDK tests yet\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "viem": "^2.21.45"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
